# 필수
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
ALLOWED_CHAT_ID=123456789

# DB: 비우면 SQLite(data/bot.db). 클라우드 PostgreSQL이면 접속 URL 입력
# DATABASE_URL=sqlite:///data/bot.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 알림 시간(KST, HH:MM)과 요일(0=월 ... 6=일)
MORNING_TIME=09:00
EVENING_TIME=17:00
ALERT_DAYS=0,1,2,3,4

# 한국 공휴일에는 알림 생략 / 주 마지막 근무일 오후 알림 뒤 주간 요약 발송
SKIP_HOLIDAYS=true
WEEKLY_SUMMARY=true

# 호스팅이 HTTP 포트를 요구할 때만 설정 (헬스체크용)
# PORT=8000
